# --- Database ---------------------------------------------------------------
# Kosongkan untuk development: data RFQ disimpan di Postgres lokal (PGlite) di folder ./.data
# Produksi: isi dengan connection string Postgres (Neon, Supabase, Railway, dsb.)
DATABASE_URL=

# --- Admin panel (/admin) ---------------------------------------------------
# Password untuk melihat daftar RFQ yang masuk. WAJIB diganti di produksi.
ADMIN_PASSWORD=ganti-dengan-password-kuat

# URL publik website (dipakai untuk sitemap & metadata)
NEXT_PUBLIC_SITE_URL=https://metaintipersada.co.id
